{
  "name": "chapter-and-verse",
  "version": "0.1.0",
  "private": true,
  "description": "Checks an LLM-generated scripture study plan against a public-domain Bible index, and reports every claim it cannot confirm.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "fetch": "bash scripts/fetch-sources.sh",
    "build": "npm run fetch && npm run build-index",
    "build-index": "vite-node src/build-index.ts",
    "verify": "vite-node src/verify-cli.ts",
    "generate": "vite-node src/generate-cli.ts",
    "report": "vite-node src/report.ts",
    "selftest": "vite-node src/selftest.ts",
    "audit": "vite-node src/verify-cli.ts fixtures/plan-that-slips-through.json",
    "reading": "vite-node src/reading-cli.ts",
    "daily": "vite-node src/reading-cli.ts today",
    "test": "vite-node src/schedule-test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.6.3",
    "vite": "^8.3.5",
    "vite-node": "^3.2.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0"
  }
}
